# Copy to .env for LOCAL development. Never commit credentials.
IRIS_HOST=
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USER=
IRIS_PASSWORD=
TRIALINK_EXPORT=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
ADMIN_PASSWORD_HASH=

# Optional local executable path. On Community Cloud leave this unset.
TESSERACT_CMD=
# Normally leave empty: the bundled Czech tessdata_best model is used.
TESSDATA_PREFIX=
